# ── API ──
PORT=3001
CORS_ORIGIN=http://localhost:3005

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Database (PostgreSQL) ──
# local dev with `npm run db:local` (embedded Postgres) listens on 5433;
# docker compose's Postgres listens on 5432.
DATABASE_URL=postgresql://bizznex:bizznex@localhost:5433/bizznex?schema=public

# ── Optional ──
# NODE_ENV=production        # requires JWT_SECRET and CORS_ORIGIN
# SWAGGER_ENABLED=false      # hide /docs
# DEMO_RESET_MINUTES=30      # shared demo workspace refresh interval
