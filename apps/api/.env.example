# ── API ──
PORT=3001
CORS_ORIGIN=http://localhost:3005

# ── Auth ──
# production refuses anything under 32 characters or containing "change-me" (try `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Database (PostgreSQL) ──
# local dev with `npm run db:local` (embedded Postgres) listens on 5433;
# docker compose's Postgres listens on 5432.
DATABASE_URL=postgresql://bizznex:bizznex@localhost:5433/bizznex?schema=public

# ── Optional ──
# NODE_ENV=production        # requires a strong JWT_SECRET and CORS_ORIGIN
# ENABLE_DOCS=true           # Swagger at /docs: on in development, off in production unless true
# TRUST_PROXY=1              # proxy hops in front of the API (default 1 in production, off otherwise; 0 disables)
# DEMO_RESET_MINUTES=30      # shared demo workspace refresh interval
